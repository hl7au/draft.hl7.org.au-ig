<?xml version="1.0" encoding="UTF-8"?>
<!-- Start by finding all references to "mydraftig" and updating to appropriate text for your IG, including changing realm -->
<ImplementationGuide xmlns="http://hl7.org/fhir">
  <id value="hl7.fhir.au.draft.mydraftig"/>
  <url value="http://draft.hl7.org.au/fhir/mydraftig/ImplementationGuide/hl7.fhir.au.draft.mydraftig"/>
  <!-- This version will propagate to all artifacts unless the "propagate-version" extension is overridden -->
  <version value="0.0.1"/>
  <name value="YourComputableMyDraftIGNameHere"/>
  <title value="Your Title for MyDraftIG Here"/>
  <status value="draft"/>
  <experimental value="true"/>
  <publisher value="Special Committee or Project or Initiative or Collective"/>
  <contact>
    <telecom>
      <!-- Or whatever URL and/or email address(es) are appropriate -->
      <system value="url"/>
      <value value="http://example.org/Special/committees/[something]"/>
    </telecom>
  </contact>
  <description value="A brief description of what MyDraftIG is about and what products or projects it is to be used for."/>
  <jurisdiction>
		<coding>
			<system value="urn:iso:std:iso:3166"/>
			<code value="AU"/>
		</coding>
	</jurisdiction>
  <packageId value="hl7.fhir.au.draft.mydraftig"/>
  <!-- This should be changed to 'not-open-source' or another license if appropriate for non-HL7-published content -->
  <license value="CC0-1.0"/>
  <!-- This is whatever FHIR version(s) the IG artifacts are targeting (not the version of this file, which should always be 'current release') -->
  <fhirVersion value="4.0.1"/>
